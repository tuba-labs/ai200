# Local editor and operating-system files
.idea/
*.iml
.DS_Store
Thumbs.db
Desktop.ini

# Local Python environments and generated bytecode
.venv/
__pycache__/
*.py[cod]
.python_packages/

# Local source caches, reports and exports
/artifacts/

# Local runtime logs
*.log
.tmp/

# Card and result link preview pages are regenerated by the site build.
/share/cards/
/share/results/

# Local Function settings and credentials must not be published with the site
local.settings.json
.env
.env.*
!.env.example

# RAG workshop runtime state, build outputs and local tooling
/workshop/.state/
/workshop/.tools/
**/target/
**/.pytest_cache/
**/*.egg-info/
/workshop/dist/
/.site/
